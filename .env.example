# ─── JARVIS Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── LLM Provider (Groq or Together AI — OpenAI-compatible, low-latency) ───────
# LLM_PROVIDER: groq | together | gemini
LLM_PROVIDER=groq

# Groq API Key — https://console.groq.com/keys
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your-groq-key-here

# Together AI API Key — https://api.together.ai/settings/api-keys
# Default model: meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TOGETHER_API_KEY=your-together-key-here

# Override the model for any provider (optional)
# LLM_MODEL=llama-3.3-70b-versatile

# Gemini API Key (legacy fallback — set LLM_PROVIDER=gemini to use)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API Key (unused — kept for legacy compatibility)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Proactive Engine thresholds
BATTERY_WARN_THRESHOLD=20       # % — alert when battery drops below this
CPU_WARN_THRESHOLD=85           # % — alert when CPU load exceeds this
MEMORY_WARN_THRESHOLD=90        # % — alert when RAM usage exceeds this
PROACTIVE_POLL_INTERVAL=30      # seconds between system checks

# Geofences — fill in actual coordinates
HOME_LAT=
HOME_LON=
DORM_LAT=               # 기숙사 중심 위도
DORM_LON=               # 기숙사 중심 경도
ACADEMY_LAT=
ACADEMY_LON=
LIBRARY_LAT=
LIBRARY_LON=

# School meal service (나이스 교육정보 개방 포털 — open.neis.go.kr)
NEIS_API_KEY=           # 나이스 API 키
NEIS_OFFICE_CODE=       # 시도교육청 코드 (e.g. K10 = 경기도)
NEIS_SCHOOL_CODE=       # 표준학교코드

# ElevenLabs TTS Voice Engine (injected automatically via GitHub Actions secret)
# Add ELEVENLABS_API_KEY to GitHub Secrets → CI/CD writes it here on every deploy
ELEVENLABS_API_KEY=sk_...your-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default) — change per voice clone

# Database (SQLite default — swap URL to migrate to PostgreSQL or Oracle)
# SQLite  : sqlite:///./jarvis.db           (default, no setup needed)
# Postgres: postgresql://user:pass@host/db
# Oracle  : oracle+oracledb://user:pass@host:port/service
DATABASE_URL=sqlite:///./jarvis.db

# CI/CD — Deploy webhook (must match DEPLOY_WEBHOOK_SECRET in GitHub Secrets)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEPLOY_WEBHOOK_SECRET=
